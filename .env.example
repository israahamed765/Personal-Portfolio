
GEMINI_API_KEY="MY_GEMINI_API_KEY"


APP_URL="MY_APP_URL"

# Firebase Client Configuration for production/external deployment.
# On Vercel these are optional if firebase-applet-config.json is present,
# but FIREBASE_FIRESTORE_DATABASE_ID must stay the named AI Studio database
# (not "(default)") or stored portfolio/messages will look empty.
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_FIRESTORE_DATABASE_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=

